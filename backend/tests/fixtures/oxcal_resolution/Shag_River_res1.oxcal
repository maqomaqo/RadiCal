 // Shag_River.oxcal, unchanged except for the Options block: calculated at
 // one-year resolution instead of OxCal's default five, to test whether
 // RadiCal's per-date agreement-index bias comes from comparing on a
 // five-year grid.
 Options()
 {
  Resolution=1;
 };
 Plot()
 {
  Curve("SHCal20","SHCal20.14c");
  Outlier_Model("General",T(5),U(0,4),"t");
  Sequence("Shag River Mouth")
  {
   Boundary("Start");
   Phase("Start Phase 1")
   {
    R_Date("NZ7756", 970, 47)
    {
     Outlier("General", 0.05);
    };
