 // Hillside_sites_3.oxcal, unchanged except for the Options block: calculated at
 // one-year resolution instead of OxCal's default five, to test whether
 // RadiCal's per-date agreement-index bias comes from comparing on a
 // five-year grid.
 Options()
 {
  Resolution=1;
 };
 Plot()
 {
  Curve("SHCal20","SHCal20.14c");
  Sequence("Hillside")
  {
   Boundary("Start Hillside");
   Sequence("North")
   {
    Phase("Fire_Feature_J")
    {
     R_Date("LD10012", 685, 25)
     {
     };
     R_Date("LD10009", 671, 21)
     {
     };
     R_Date("LD10011", 635, 21)
     {
     };
    };
   };
   Sequence("South")
   {
    Phase("Fires")
    {
     Phase("Fire_Feature_K")
     {
      R_Date("LD10006", 671, 20)
      {
      };
      R_Date("LD10007", 647, 21)
      {
      };
      R_Date("LD10008", 636, 21)
      {
      };
     };
     Phase("Fire_Feature_A")
     {
      R_Date("LA10003", 676, 26)
      {
      };
      R_Date("LA10001", 637, 24)
      {
      };
     };
    };
   };
   Boundary("End Hillside");
  };
 };
