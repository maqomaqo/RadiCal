 // SRM (Shag River Mouth dune sequence, Petchey), rebuilt from the OxCal
 // results table for SRM_Petchey: same elements, names, order and dates.
 // Calculated at one-year resolution instead of OxCal's default five.
 Options()
 {
  Resolution=1;
 };
 Plot()
 {
  Outlier_Model("General",T(5),U(0,4),"t");
  Curve("SHCal20","SHCal20.14c");
  Sequence("SRM Dune")
  {
   Boundary("Start 11");
   Phase("SRM Layer 11")
   {
    R_Date("WkA-43681 egg", 614, 20)
    {
     Outlier("General", 0.05);
    };
    R_Date("WkA-43682 egg", 627, 20)
    {
     Outlier("General", 0.05);
    };
   };
   Boundary("SRM End 11");
   Interval("Interval L9/11");
   Boundary("SRM Start 9");
   Phase("SRM Layer 9")
   {
    R_Date("WkA-55312 ch", 694, 16)
    {
     Outlier("General", 0.05);
    };
    R_Date("WkA-56765 egg", 709, 16)
    {
     Outlier("General", 0.05);
    };
   };
   Boundary("SRM End 9");
   Phase("SRM Layer 8")
   {
    Interval("Interval L8/9");
   };
   Boundary("SRM Start 7");
   Phase("SRM Layer 7")
   {
    R_Date("WkA-55309 ch", 623, 16)
    {
     Outlier("General", 0.05);
    };
    R_Date("WkA-55308 ch", 645, 16)
    {
     Outlier("General", 0.05);
    };
   };
   Boundary("SRM Layer 6 lower");
   Interval("Interval L7/6");
   Boundary("SRM Layer 6 upper");
   Phase("SRM Layer 6")
   {
    R_Date("WkA-55307 ch", 546, 15)
    {
     Outlier("General", 0.05);
    };
    R_Date("WkA-56764 ch", 565, 16)
    {
     Outlier("General", 0.05);
    };
   };
   Boundary("SRM Start 5");
   Phase("SRM Layer 5")
   {
    R_Date("WkA-60533 egg", 597, 18)
    {
     Outlier("General", 0.05);
    };
    R_Date("WkA-56203 pigeon bone", 590, 15)
    {
     Outlier("General", 0.05);
    };
    R_Date("WkA-55305 ch", 620, 15)
    {
     Outlier("General", 0.05);
    };
   };
   Boundary("SRM Start 4");
