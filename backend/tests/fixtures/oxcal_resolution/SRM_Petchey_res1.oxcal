    {
     Outlier("General", 0.05);
    };
   };
   Boundary("SRM End 3");
   Span("Span SRM");
  };
  Difference("Difference 11/9","SRM Start 9","SRM End 11");
  Difference("Difference 9/7","SRM Start 7","SRM End 9");
 };
