# Bytes that are hashed must be the same bytes on every checkout. Git for
# Windows converts line endings by default, which would change the SHA-256
# of the curve files and of every corpus file, both of which the desktop corpus
# tests check.
calibration_data/** -text
desktop/corpus/** -text
# The desktop corpus tests read some backend fixtures directly (OxCal models,
# the captured reservoir response) and compare to what Python read from them.
backend/tests/fixtures/** -text
