{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RadiCal",
  "version": "0.1.3",
  "identifier": "io.github.maqomaqo.radical",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
