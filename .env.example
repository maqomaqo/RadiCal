# Database
#
# The Docker stack builds the backend's connection string from the three
# POSTGRES_* values below and ignores DATABASE_URL. DATABASE_URL is for a
# backend run directly on this machine (see docs/INSTALLATION.md), which reads
# this file: point it at localhost, port 5433 for the stack's own Postgres or
# 5432 for one installed locally.
DATABASE_URL=postgresql://radiocarbon:password@localhost:5433/radiocarbon_db
POSTGRES_USER=radiocarbon
POSTGRES_PASSWORD=password
POSTGRES_DB=radiocarbon_db

# CORS -- origins the backend accepts requests from
CORS_ORIGINS=http://localhost:5173

# Authentication.
#
# RADICAL_SECRET_KEY signs every login token. Leave it unset locally and the
# app uses a built-in development key and says so at startup; set RADICAL_ENV
# to anything other than development/dev/test and the app REFUSES to start
# without a real one, because a published signing key means anyone holding
# this source can mint a token for any account.
#
# Generate one with (python3 on macOS, py on Windows):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# RADICAL_ENV=production
# RADICAL_SECRET_KEY=

# Password-reset emails. Optional: without them, "Forgot your password?" tells
# people to ask whoever runs RadiCal, who resets it with
#   docker compose exec radical python -m app.reset_password someone@example.org
# RADICAL_PUBLIC_URL is the address people open RadiCal at; the emailed link
# points there. SECURITY is starttls (port 587), ssl (port 465) or none.
# RADICAL_PUBLIC_URL=https://radical.example.org
# RADICAL_SMTP_HOST=smtp.example.org
# RADICAL_SMTP_PORT=587
# RADICAL_SMTP_SECURITY=starttls
# RADICAL_SMTP_USER=
# RADICAL_SMTP_PASSWORD=
# RADICAL_SMTP_FROM=radical@example.org

# Set to 1 to stop the backend bringing the database up to the current schema
# on startup, for a deployment that would rather run `alembic upgrade head`
# deliberately. Leave unset for a local install.
# RADICAL_SKIP_MIGRATIONS=1

# Set to true when the checkout is on a Windows drive (C:\...) and the Docker
# stack's frontend does not pick up edits: Docker Desktop passes no
# file-change events from Windows into the container, so it has to poll.
# CHOKIDAR_USEPOLLING=true

# Calibration curve files. Only needed if they live somewhere other than
# calibration_data/ in this checkout (the backend finds them there, and the
# Docker stack mounts them at /app/data).
# INTCAL_CURVE_PATH=/app/data/intcal20.14c
# MARINE_CURVE_PATH=/app/data/marine20.14c
# SHCAL_CURVE_PATH=/app/data/shcal20.14c
