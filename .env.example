# Frontend
VITE_API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://radiocarbon:password@postgres:5432/radiocarbon_db
POSTGRES_USER=radiocarbon
POSTGRES_PASSWORD=password
POSTGRES_DB=radiocarbon_db

# CORS -- origins the backend accepts requests from
CORS_ORIGINS=http://localhost:5173

# Set to 1 to stop the backend bringing the database up to the current schema
# on startup, for a deployment that would rather run `alembic upgrade head`
# deliberately. Leave unset for a local install.
# RADICAL_SKIP_MIGRATIONS=1

# Calibration curve files (defaults match the Docker volume mount at
# calibration_data/ -> /app/data; only needed if running the backend
# outside Docker with the data somewhere else)
INTCAL_CURVE_PATH=/app/data/intcal20.14c
MARINE_CURVE_PATH=/app/data/marine20.14c
SHCAL_CURVE_PATH=/app/data/shcal20.14c
