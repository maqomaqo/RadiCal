# Frontend
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Radiocarbon Calibration Webapp

# Backend
BACKEND_PORT=8000
DEBUG=False

# Database
DATABASE_URL=postgresql://radiocarbon:password@postgres:5432/radiocarbon_db
POSTGRES_USER=radiocarbon
POSTGRES_PASSWORD=password
POSTGRES_DB=radiocarbon_db

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Bayesian Analysis
MCMC_SAMPLES=2000
MCMC_TUNE=1000
MCMC_CHAINS=4
MCMC_CORES=-1

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# API Keys (optional)
API_SECRET_KEY=your-secret-key-here
