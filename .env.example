# Authentication.
#
# RADICAL_SECRET_KEY signs every login token. Leave it unset locally and the
# app uses a built-in development key and says so at startup; set RADICAL_ENV
# to anything other than development/dev/test and the app REFUSES to start
# without a real one, because a published signing key means anyone holding
# this source can mint a token for any account.
#
# Generate one with:
#   docker compose run --rm server new-secret
#
# RADICAL_ENV=production
# RADICAL_SECRET_KEY=

# Password-reset emails. Optional: without them, "Forgot your password?" tells
# people to ask whoever runs RadiCal, who resets it with
#   docker compose exec server radical-server reset-password someone@example.org
# RADICAL_PUBLIC_URL is the address people open RadiCal at; the emailed link
# points there. SECURITY is starttls (port 587), ssl (port 465) or none.
# RADICAL_PUBLIC_URL=https://radical.example.org
# RADICAL_SMTP_HOST=smtp.example.org
# RADICAL_SMTP_PORT=587
# RADICAL_SMTP_SECURITY=starttls
# RADICAL_SMTP_USER=
# RADICAL_SMTP_PASSWORD=
# RADICAL_SMTP_FROM=radical@example.org

# Set to true when the checkout is on a Windows drive (C:\...) and the Docker
# stack's frontend does not pick up edits: Docker Desktop passes no
# file-change events from Windows into the container, so it has to poll.
# CHOKIDAR_USEPOLLING=true
